{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || ^26.0.0"
  },
  "scripts": {
    "predev": "npm run sanitize:lasereyes",
    "dev": "next dev",
    "prebuild": "npm run sanitize:lasereyes",
    "build": "next build --webpack",
    "postbuild": "npm run check:browser-secrets && if [ \"$GENERATE_SOURCEMAPS\" = \"true\" ]; then posthog-cli sourcemap inject --directory .next && if [ -n \"$POSTHOG_CLI_TOKEN\" ] && [ -n \"$POSTHOG_CLI_ENV_ID\" ]; then posthog-cli sourcemap upload --directory .next; else echo 'Skipping PostHog sourcemap upload: POSTHOG_CLI_TOKEN or POSTHOG_CLI_ENV_ID not set'; fi; fi",
    "start": "next start",
    "lint": "eslint src",
    "format": "prettier --write .",
    "test": "vitest",
    "prepare": "husky install",
    "sanitize:lasereyes": "node --import tsx scripts/sanitize-lasereyes-maestro-credentials.ts",
    "check:browser-secrets": "node --import tsx scripts/verify-browser-bundle-secrets.ts",
    "secretlint": "secretlint \"**/*\" --maskSecrets"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100,
    "tabWidth": 2,
    "plugins": [
      "prettier-plugin-tailwindcss"
    ]
  },
